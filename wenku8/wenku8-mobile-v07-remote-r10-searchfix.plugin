#!name= Wenku8 Mobile v0.7 · Remote R10 Search Fix
#!desc= Wenku8 Mobile 本体固定 v0.7；R10 修复真实搜索入口 /so.php：搜索提交与搜索响应不经过 Wenku8 request/response 脚本，其余页面沿用稳定 R8。
#!author= OpenAI

[Rule]
DOMAIN-SUFFIX,wenku8.net,DIRECT
DOMAIN-SUFFIX,wenku8.com,DIRECT
DOMAIN-SUFFIX,wkcdn.net,DIRECT

[Script]
http-request ^https:\/\/www\.wenku8\.net\/(?!so\.php(?:[\/?]|$)|modules\/article\/search\.php(?:[\/?]|$)) script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/wenku8/wenku8-no-compress.js?v=1,timeout=10,tag=Wenku8-NoCompression-R10,enable=true
http-response ^https:\/\/www\.wenku8\.net\/(?!so\.php(?:[\/?]|$)|modules\/article\/search\.php(?:[\/?]|$)) script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/bceedc73a367403dcb9dbc673ffd7ebdb482f1d7/wenku8/wenku8-mobile-v07-loon.js,requires-body=true,binary-body-mode=true,timeout=15,tag=Wenku8-Mobile-v07-R10,enable=true

[MITM]
hostname = www.wenku8.net,wenku8.net
