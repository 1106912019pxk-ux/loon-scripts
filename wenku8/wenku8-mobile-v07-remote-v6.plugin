#!name= Wenku8 Mobile v0.7 Remote v6
#!desc= 纯远程版 Wenku8 Mobile v0.7。增加运行时诊断，定位 v0.7 未生成界面的具体原因；无需 iCloud / Stay。
#!author= OpenAI

[Rule]
DOMAIN-SUFFIX,wenku8.net,DIRECT
DOMAIN-SUFFIX,wenku8.com,DIRECT
DOMAIN-SUFFIX,wkcdn.net,DIRECT

[Script]
http-request ^https:\/\/www\.wenku8\.net\/ script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/wenku8/wenku8-no-compress.js?v=1,timeout=10,tag=Wenku8-NoCompression-v6,enable=true
http-response ^https:\/\/www\.wenku8\.net\/ script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/wenku8/wenku8-mobile-v07-loon.js?v=8,requires-body=true,binary-body-mode=true,timeout=15,tag=Wenku8-Mobile-v07-v6,enable=true

[MITM]
hostname = www.wenku8.net,wenku8.net
