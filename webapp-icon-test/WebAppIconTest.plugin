#!name= Web App 主屏幕图标测试 · Legacy
#!desc= 兼容旧版 Loon：为 example.com 注入自定义 apple-touch-icon；独立测试，不影响现有插件。
#!author= OpenAI

[Rewrite]
^https:\/\/example\.com\/?(?:\?.*)?$ response-body-replace-regex (?i)<\/head> <link\x20rel="apple-touch-icon"\x20sizes="180x180"\x20href="https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/webapp-icon-test/icon.png?v=2"><link\x20rel="icon"\x20href="https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/webapp-icon-test/icon.png?v=2"><meta\x20name="apple-mobile-web-app-capable"\x20content="yes"><\/head>

[MITM]
hostname = example.com
