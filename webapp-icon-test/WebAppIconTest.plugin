#!name= Web App 主屏幕图标测试 · Script R4
#!desc= 兼容现有 Loon 脚本能力：接管 iOS 添加到主屏幕请求的 /apple-touch-icon*.png，由 request-script 直接返回 GitHub PNG。
#!author= OpenAI

[Script]
http-request ^https:\/\/example\.com\/apple-touch-icon(?:-\d+x\d+)?(?:-precomposed)?\.png(?:\?.*)?$ script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/webapp-icon-test/webapp-icon-mock.js?v=5,timeout=10,tag=WebApp-Icon-R4,enable=true

[MITM]
hostname = example.com
