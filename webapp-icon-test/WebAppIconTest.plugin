#!name= Web App 主屏幕图标测试 · Legacy R3
#!desc= 兼容旧版 Loon：直接接管 iOS 添加到主屏幕请求的 /apple-touch-icon*.png，并原地返回 GitHub 自定义 PNG；不依赖 302。
#!author= OpenAI

[Rewrite]
# SafariViewService 会请求默认 touch icon 路径；直接返回 PNG 本体
^https:\/\/example\.com\/apple-touch-icon(?:-\d+x\d+)?(?:-precomposed)?\.png(?:\?.*)?$ mock-response-body data-type=png data-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/main/webapp-icon-test/icon.png?v=4 status-code=200

[MITM]
hostname = example.com
