#!name= 轻之国度 Mobile · R7 Stable Candidate
#!desc= 基于稳定 R3：修复双列列表中缝、保留两侧留白；详情页维持 R6 最终对齐，但通过预渲染遮罩消除封面明显移动/放大过程。好书推荐沿用已验证修复。仅处理 GET HTML，POST 搜索/登录/发帖不碰。
#!author= OpenAI

[Script]
http-response ^https:\/\/(?:www\.)?lightnovel\.fun(?:\/|$) script-path=https://raw.githubusercontent.com/1106912019pxk-ux/loon-scripts/898c7ea2186568010b005a803a4101c08ebaf34f/lightnovel/lightnovel-r7-inject.js,requires-body=true,binary-body-mode=false,timeout=15,tag=LightNovel-Mobile-R7,enable=true

[MITM]
hostname = lightnovel.fun,*.lightnovel.fun
